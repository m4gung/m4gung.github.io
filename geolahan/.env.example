# Konfigurasi GeoLahan Pro. File ini TIDAK berisi rahasia.
# Salin menjadi .env.local bila ingin mengubah nilai default.

# Endpoint geocoding Nominatim (bisa diganti ke instance sendiri).
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org

# Batasi pencarian ke negara tertentu (kode ISO 3166-1 alpha-2, pisahkan koma). Kosongkan untuk global.
VITE_GEOCODER_COUNTRYCODES=id

# Opsional: email kontak sesuai kebijakan penggunaan Nominatim untuk volume permintaan tinggi.
VITE_GEOCODER_EMAIL=
