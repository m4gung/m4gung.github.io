{
  "name": "scanpro",
  "version": "1.0.0",
  "description": "ScanPro Studio - Local-first document scanning, PDF editing, canvas editing, OCR, and printing PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs && npx gh-pages -d dist"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.31",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^3.0.0"
  }
}
